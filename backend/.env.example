# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo usado nas chamadas à API. claude-3-5-sonnet-20241022 foi o modelo
# especificado no briefing original; troque para o modelo mais recente
# disponível na sua conta (ex: claude-sonnet-5) quando quiser.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database (SQLite por padrão no MVP; troque para Postgres em produção)
DATABASE_URL=sqlite:///./suportia.db

# Frontend (usado para CORS)
FRONTEND_URL=http://localhost:5173

# Stripe (fase 3 - opcional por enquanto)
STRIPE_API_KEY=
